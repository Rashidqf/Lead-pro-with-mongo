MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lead-flow-pro
AUTH_SECRET=
APP_URL=http://localhost:3000

# Optional: encrypt Google refresh tokens (defaults to AUTH_SECRET)
TOKEN_ENCRYPTION_KEY=

# Optional: Google Calendar (per-user OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Optional: Firebase browser push (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional: Firebase Admin (server cron)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: protect /api/cron/reminders
CRON_SECRET=

# Optional: used only by `pnpm export:mongo`
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EXPORT_EMAIL=
SUPABASE_EXPORT_PASSWORD=
